{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deepseek Harness Desktop",
  "version": "0.4.1",
  "identifier": "io.github.hairyf.deepseek-harness-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["resources/**/*"],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 deepseek-harness-desktop contributors",
    "shortDescription": "Desktop application for DeepSeek Harness",
    "longDescription": "A native desktop application for running DeepSeek Harness (dsh) locally with one-click install and zero configuration."
  }
}
